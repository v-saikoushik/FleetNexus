# =============================================================================
# FleetNexus Environment Variables — TEMPLATE
# Copy this file to .env and replace ALL placeholder values before running.
# NEVER commit the real .env file.
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=FleetNexus

# API
API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000/api

# Database (PostgreSQL)
POSTGRES_USER=fleetnexus
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=fleetnexus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fleetnexus:CHANGE_ME_DB_PASSWORD@localhost:5432/fleetnexus?schema=public

# JWT — replace with a long, random, secret value before running
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
