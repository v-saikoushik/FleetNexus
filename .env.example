# =============================================================================
# FleetNexus Environment Variables
# Copy this file to .env and adjust values for your local environment.
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=FleetNexus

# API
API_PORT=3000
API_HOST=0.0.0.0
API_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000/api

# Database (PostgreSQL)
POSTGRES_USER=fleetnexus
POSTGRES_PASSWORD=fleetnexus
POSTGRES_DB=fleetnexus
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fleetnexus:fleetnexus@localhost:5432/fleetnexus?schema=public

# JWT (placeholders — auth not implemented yet)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
